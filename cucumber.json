{
  "default": {
    "tags":"@registerPOM",
    "dryRun": false,
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": ["PlaywrightAutomationCode/FeatureFiles/**/*.feature"],
    "require": [
      "PlaywrightAutomationCode/StepDefinition/**/*.ts",
      "PlaywrightAutomationCode/**/*.ts",
      "PlaywrightAutomationCode/StepDefinition/**/*.js"

    ],
    "requireModule": ["ts-node/register/type-check"],
    "format": [
      "progress-bar",
      "html:test-result/cucumber-report.html",
      "json:test-result/cucumber-report.json",
      "rerun:@rerun.txt"
    ]
  }
}
